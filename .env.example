# Copy to .env and fill in. Never commit .env.
APP_URL=http://localhost:3000

# SQLite (ADR 0005). compose overrides this with file:/data/quizz.db
DATABASE_URL=file:./data/quizz.db

# Required: the app refuses to start without these. Generate each with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# HMAC key for Learner emails (ADR 0002). Losing it breaks every email lookup; back it up.
EMAIL_HMAC_SECRET=

# Silo (pgsty/silo) or any S3-compatible store. compose uses these as Silo's root credentials.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=quizz
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SMTP. Locally this is Mailpit (UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Quizz <no-reply@quizz.localhost>
DAILY_EMAIL_CAP=300

# Google sign-in. The button stays hidden while the id is empty or "placeholder".
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# Operator (receives abuse reports)
OPERATOR_EMAIL=operator@quizz.localhost
